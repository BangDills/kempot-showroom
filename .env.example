# Salin ke .env.local untuk pengembangan, dan set sebagai env vars di Coolify untuk produksi.
# Ambil dari Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Nomor WhatsApp showroom (format internasional tanpa +)
NEXT_PUBLIC_WA_NUMBER=6281234567890

# Nama showroom (dipakai di judul & pesan WhatsApp)
NEXT_PUBLIC_SHOWROOM_NAME=Kempot Showroom
